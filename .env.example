#
# -- RLS policies (enable row-level security on all tables)
# alter table firms enable row level security;
# alter table jobs enable row level security;
# alter table transactions enable row level security;
# alter table clients enable row level security;
#
# create policy "Users can manage their own firm" on firms
#   for all using (owner_id = auth.uid());
# create policy "Users can manage jobs in their firm" on jobs
#   for all using (firm_id in (select id from firms where owner_id = auth.uid()));
# create policy "Users can manage transactions in their firm's jobs" on transactions
#   for all using (job_id in (select j.id from jobs j join firms f on f.id = j.firm_id where f.owner_id = auth.uid()));
# create policy "Users can manage clients in their firm" on clients
#   for all using (firm_id in (select id from firms where owner_id = auth.uid()));
