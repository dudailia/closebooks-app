# ── CloseBooks Environment Variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# The app runs in demo/localStorage mode when optional vars are omitted.

# ── AI (Required for categorization and all AI features) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase (Required for multi-user auth and cloud persistence) ─────────────
# Create a project at https://app.supabase.com
# Leave as-is to skip auth; app works fully without these in demo mode.
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service-role key — used server-side only (webhooks, portal lookups).
# NEVER expose this to the browser. Keep it out of NEXT_PUBLIC_ prefixed vars.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Stripe (Required for billing / subscriptions) ────────────────────────────
# Create products at https://dashboard.stripe.com/products
# Leave as-is to skip billing; pricing page shows "Coming soon".
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create these in your Stripe dashboard
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_GROWTH=price_...

