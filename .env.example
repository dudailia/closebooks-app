# ── CloseBooks Environment Variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Production app URL (no trailing slash) — used for CORS on /api routes
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
# Without Supabase, the dashboard still loads but firm data stays in browser memory until configured.

# ── AI (Required for categorization and all AI features) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (optional — PDF "Send to client" from review page) ────────────────
# https://resend.com — verify your domain and set a from address
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="Your Firm <reports@yourdomain.com>"

# ── Cron (optional — scheduled reports placeholder) ───────────────────────────
# CRON_SECRET=...

# ── Supabase (Required for multi-user auth and cloud persistence) ─────────────
# Create a project at https://app.supabase.com
# Leave as-is to skip auth; app works fully without these in demo mode.
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service-role key — used server-side only (webhooks, portal lookups).
# NEVER expose this to the browser. Keep it out of NEXT_PUBLIC_ prefixed vars.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Stripe (Required for billing / subscriptions) ────────────────────────────
# Create products at https://dashboard.stripe.com/products
# Leave as-is to skip billing; pricing page shows "Coming soon".
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create monthly + annual (20% off annual) per tier in Stripe Dashboard
# Server-only (webhook maps price → plan tier)
STRIPE_PRICE_STARTER_MONTH=price_...
STRIPE_PRICE_STARTER_YEAR=price_...
STRIPE_PRICE_PRO_MONTH=price_...
STRIPE_PRICE_PRO_YEAR=price_...
STRIPE_PRICE_ENTERPRISE_MONTH=price_...
STRIPE_PRICE_ENTERPRISE_YEAR=price_...
# Client (pricing page checkout)
NEXT_PUBLIC_STRIPE_PRICE_STARTER_MONTH=price_...
NEXT_PUBLIC_STRIPE_PRICE_STARTER_YEAR=price_...
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTH=price_...
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEAR=price_...
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE_MONTH=price_...
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE_YEAR=price_...

# ── Intuit QuickBooks Online (OAuth) ───────────────────────────────────────
# Create an app at https://developer.intuit.com — add redirect URL:
#   https://YOUR_DOMAIN/api/integrations/quickbooks/callback
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
# Optional overrides (defaults work for production US companies):
# INTUIT_OAUTH_BASE=https://appcenter.intuit.com/connect/oauth2
# INTUIT_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
# INTUIT_REDIRECT_URI=https://YOUR_DOMAIN/api/integrations/quickbooks/callback

