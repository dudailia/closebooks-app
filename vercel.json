{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/categorize/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/autopilot/start-close/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/tax-draft/create/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/tax-draft/analyze/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/audit-defense/analyze/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/audit-defense/generate-package/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/advisory/generate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/1099/generate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/parse-pdf/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
